# Copy to .env.test.local. Supply a separate test database and independent random secrets.
E2E_SSO_ISSUER=https://rmc-sso.cipcloud.net
E2E_SSO_CLIENT_ID=bam
E2E_SSO_CLIENT_SECRET=
E2E_SSO_AUTHORIZE_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/authorize
E2E_SSO_TOKEN_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/token
E2E_SSO_USERINFO_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/userinfo
E2E_SSO_END_SESSION_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/endsession
E2E_SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback/rmc-sso
E2E_SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/signed-out
E2E_DATABASE_URL=
E2E_APP_SESSION_SECRET=
E2E_SUPER_ADMIN_EMPLOYEE_CODES=

# Optional dedicated PostgreSQL server-suite databases:
CR056_TEST_DATABASE_URL=
MODULE_TEST_DATABASE_URL=
