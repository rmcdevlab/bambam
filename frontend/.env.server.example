# Copy these server-only entries into .env.local for local Next.js execution.
# Reuse the existing backend values, including the same APP_SESSION_SECRET.
# Never copy secrets into .env.development / .env.production or NEXT_PUBLIC_*.
APP_ENV=development
DATABASE_URL=postgres://bambam:bambam@localhost:5433/bambam?sslmode=disable
APP_SESSION_SECRET=
APP_SESSION_TTL=12h
SSO_ISSUER=https://rmc-sso.cipcloud.net
SSO_AUTHORIZE_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/authorize
SSO_TOKEN_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/token
SSO_USERINFO_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/userinfo
SSO_END_SESSION_URL=https://rmc-sso.cipcloud.net/api/auth/oauth2/endsession
SSO_CLIENT_ID=bam
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:3000/api/auth/callback/rmc-sso
SSO_POST_LOGOUT_REDIRECT_URI=http://localhost:3000/signed-out
SSO_SCOPE=openid profile email offline_access
SSO_CLOCK_SKEW=60s
ROLE_SWITCHER_ENABLED=true
SUPER_ADMIN_EMPLOYEE_CODES=

# Use a persistent absolute directory in UAT/production.
PHOTO_STORAGE_DIR=./data/photos
# interval = long-running Node.js; external = scheduler POST /api/internal/maintenance.
MAINTENANCE_SCHEDULER=interval
# Optional separate bearer secret for the external scheduler (minimum 32 characters).
# MAINTENANCE_JOB_SECRET=
