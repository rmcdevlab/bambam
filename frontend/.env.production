# Committed. Non-secret production values only. NEXT_PUBLIC_* is baked in at build time.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Internal URL of the Next.js API as seen from the Next.js server (set by the deploy platform if different).
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_ROLE_SWITCHER=false

# CR-056: server environment (secrets belong in injected env / .env.local).
APP_ENV=production
