# secrets
*.pem

# frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/playwright-report/
frontend/test-results/
frontend/coverage/

# obsidian (keep app.json so link settings are shared)
docs/.obsidian/workspace*.json
docs/.obsidian/cache
docs/.obsidian/plugins/

# os / editor
.DS_Store
Thumbs.db
